{
  "name": "ai-email-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Email Assistant powered by OpenRouter",
  "engines": {
    "node": ">=18.11.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,cyan \"npm run server\" \"npm run client\"",
    "server": "node --watch server.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
